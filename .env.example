# Copy to .env.local for local work. In production, set these in Vercel > Settings > Environment Variables.
# Never commit real values.

# Neon (Postgres)
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-south-1.aws.neon.tech/neondb?sslmode=require

# Vaani.ai
# Vaani sends no signature, so this secret goes in the webhook address: /api/webhooks/vaani?token=<this value>
VAANI_WEBHOOK_SECRET=
# Needed to read the caller's number and the call cost (the webhook has neither). Create it in the Vaani dashboard.
VAANI_API_KEY=
# Rupees per Vaani credit. Vaani reports call cost in credits. Ask Vaani support, default 1.
VAANI_CREDIT_TO_INR=1

# Cal.com
CALCOM_WEBHOOK_SECRET=
CALCOM_API_KEY=

# HubSpot (private app token)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
# Optional. Defaults to the built-in stages of HubSpot's default deal pipeline (see src/lib/clients/hubspot.ts).
HUBSPOT_PIPELINE_ID=default
HUBSPOT_STAGE_BOOKED=
HUBSPOT_STAGE_NEW=
HUBSPOT_STAGE_CANCELLED=

# Resend
RESEND_API_KEY=
EMAIL_FROM="Aangan Studio <system@yourdomain.com>"

# Who gets emails. Both can be changed later on the Settings page.
OWNER_EMAIL=
FRONT_DESK_EMAIL=
# Used only if Vaani reports costs in USD
USD_TO_INR=85

# Post-call extraction: "vaani" uses Vaani's own fields, "llm" extracts from the transcript
EXTRACTION_MODE=vaani
# Only needed when EXTRACTION_MODE=llm
ANTHROPIC_API_KEY=

# Dashboard login (magic links). AUTH_SECRET must be a long random value (32+ characters).
AUTH_SECRET=
# Visitors who are not signed in may look at Home, Calls and Reports (read-only). Set to true to require sign-in for everything.
REQUIRE_LOGIN=false
# The public address of the dashboard. Sign-in links point here.
APP_URL=http://localhost:3000
# The number callers dial. Shown on the dashboard when there are no calls yet.
STUDIO_PHONE=

# Weekly summary cron (Vercel sends this as a Bearer token)
CRON_SECRET=
